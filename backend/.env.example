# Backend Configuration (copy to backend/.env and adjust; placeholders only)
ENVIRONMENT="development"
SECRET_KEY="change-me-to-a-long-random-string"
ALGORITHM="HS256"

# Short-lived access token + refresh token used by POST /api/auth/refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Failed-login rate limiting (sliding window, per process).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Database (relative sqlite paths are anchored to backend/ by app.config)
DATABASE_URL="sqlite:///./dualwell.db"

# Wearable Credentials (optional; Fitbit provider is "coming soon" in the UI)
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""