# DualWell: Environment Configuration Example
# NOTE: the backend reads backend/.env (anchored to backend/ regardless of the
# launch directory); this root-level template is kept for reference only.
# Never put real secrets in this file.

# Backend Settings
# development | staging | production. Non-development environments refuse to
# start while SECRET_KEY is a placeholder or shorter than 32 characters.
ENVIRONMENT="development"
SECRET_KEY="change-me-to-a-long-random-string"
ALGORITHM="HS256"

# Short-lived access token + refresh token used by POST /api/auth/refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Failed-login rate limiting (sliding window, in-memory per process).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Database Connection (Default is SQLite, can be swapped for PostgreSQL)
# Relative sqlite paths are anchored to backend/ by app.config.
DATABASE_URL="sqlite:///./dualwell.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/dualwell_db"

# Optional Real Smartwatch API Credentials
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""

# Frontend API Base URL (used by Vite client; lives in frontend/.env)
VITE_API_BASE_URL="http://localhost:8000/api"