# DualWell: Environment Configuration Example

# Backend Settings
PROJECT_NAME="DualWell: Smart Student Wellness and Academic Performance System"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (Default is SQLite, can be swapped for PostgreSQL)
DATABASE_URL="sqlite:///./dualwell.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/dualwell_db"

# Optional Real Smartwatch API Credentials
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""

# Frontend API Base URL (used by Vite client)
VITE_API_BASE_URL="http://localhost:8000/api"
